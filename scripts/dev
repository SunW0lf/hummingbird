#!/usr/bin/env bash
# Serve app/ locally for development. No build step required to view the Phase 1 site.
set -euo pipefail

cd "$(dirname "$0")/.."

PORT="${PORT:-8080}"

if command -v python3 >/dev/null 2>&1; then
  echo "Serving app/ at http://localhost:${PORT} (python3)"
  python3 -m http.server "${PORT}" --directory app
elif command -v python >/dev/null 2>&1; then
  echo "Serving app/ at http://localhost:${PORT} (python)"
  python -m http.server "${PORT}" --directory app
else
  echo "error: python or python3 is required for the dev server but was not found" >&2
  exit 1
fi
