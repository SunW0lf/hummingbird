#!/usr/bin/env bash
# Deploy dist/ to Cloudflare Pages. Intended to be invoked by CI after tests/build
# succeed on the protected main branch, but is safe to run locally by a steward.
#
# Requires CLOUDFLARE_API_TOKEN (scoped to the datum.quest zone: Pages:Edit, DNS:Edit)
# to be set in the environment. Refuses to run without it rather than failing silently
# or falling back to a broader ambient credential.
set -euo pipefail

cd "$(dirname "$0")/.."

if [ -z "${CLOUDFLARE_API_TOKEN:-}" ]; then
  echo "error: CLOUDFLARE_API_TOKEN is not set. Refusing to deploy." >&2
  echo "Set it as a GitHub Actions secret (CI) or a local environment variable (steward-only manual deploy)." >&2
  exit 1
fi

if [ -z "${CLOUDFLARE_ACCOUNT_ID:-}" ]; then
  echo "error: CLOUDFLARE_ACCOUNT_ID is not set. Refusing to deploy." >&2
  echo "Not a secret - just an identifier. Set it as a GitHub Actions repo variable (CI) or a local environment variable." >&2
  exit 1
fi

if [ ! -d dist ]; then
  echo "error: dist/ not found. Run ./scripts/build first." >&2
  exit 1
fi

PROJECT_NAME="${CLOUDFLARE_PAGES_PROJECT:-hummingbird}"

echo "Deploying dist/ to Cloudflare Pages project '${PROJECT_NAME}'..."
npx wrangler pages deploy dist --project-name="${PROJECT_NAME}"

echo "Deploy complete."
