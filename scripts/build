#!/usr/bin/env bash
# Build produces dist/ from app/. Phase 1 has no compilation step (plain HTML/CSS),
# so "build" means: validate, then produce a clean, deployable copy.
set -euo pipefail

cd "$(dirname "$0")/.."

echo "Cleaning dist/..."
rm -rf dist
mkdir -p dist

echo "Copying app/ -> dist/..."
cp -r app/. dist/

echo "Rendering canonical reference documents..."
node scripts/render-docs.js

echo "Rendering support page..."
node scripts/render-support.js

echo "Build complete: dist/"
