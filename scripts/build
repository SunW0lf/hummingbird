#!/usr/bin/env bash
# Build produces dist/ from app/. Phase 2 remains intentionally simple:
# static source is copied, then canonical/public surfaces are rendered.
set -euo pipefail

cd "$(dirname "$0")/.."

echo "Cleaning dist/..."
rm -rf dist
mkdir -p dist

echo "Copying app/ -> dist/..."
cp -r app/. dist/

echo "Rendering canonical reference documents..."
node scripts/render-docs.js

echo "Rendering public decision records..."
node scripts/render-decisions.js

echo "Rendering public canonical-record projection..."
node scripts/render-public-records.js

echo "Rendering support page..."
node scripts/render-support.js

echo "Finalizing public HTML accessibility/navigation..."
node scripts/finalize-html.js

echo "Rendering sitemap..."
node scripts/render-sitemap.js

echo "Build complete: dist/"
