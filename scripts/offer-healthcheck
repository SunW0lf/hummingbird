#!/usr/bin/env bash
set -euo pipefail

BASE_URL="${HEALTHCHECK_URL:-https://datum.quest}"
BASE_URL="${BASE_URL%/}"
UA="Hummingbird-Offer-Smoke/1.0"

page=$(curl -sS --max-time 20 -A "$UA" -H 'Accept: text/html' "$BASE_URL/offer")
if ! grep -Fq 'open for testing' <<<"$page" || ! grep -Fq 'action="/offer"' <<<"$page"; then
  echo "error: live offer page marker or form missing" >&2
  exit 1
fi

status=$(curl -sS -o /tmp/hummingbird-offer-invalid.body -w '%{http_code}' \
  --max-time 20 -A "$UA" \
  -H 'Accept: application/json' \
  -H 'Content-Type: application/x-www-form-urlencoded' \
  --data 'offer=' \
  "$BASE_URL/offer")

if [ "$status" != "400" ]; then
  echo "error: invalid offer expected HTTP 400, got $status" >&2
  cat /tmp/hummingbird-offer-invalid.body >&2 || true
  exit 1
fi

if ! grep -Fq 'invalid_offer' /tmp/hummingbird-offer-invalid.body; then
  echo "error: invalid offer response did not expose expected validation code" >&2
  exit 1
fi

rm -f /tmp/hummingbird-offer-invalid.body

mcp() {
  curl -sS --max-time 20 -A "$UA" \
    -H 'Content-Type: application/json' \
    -H 'Accept: application/json, text/event-stream' \
    --data "$1" "$BASE_URL/offer/mcp"
}

init=$(mcp '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"hummingbird-smoke","version":"1"}}}')
if ! grep -Fq '"protocolVersion":"2025-06-18"' <<<"$init"; then
  echo "error: MCP door did not answer initialize" >&2
  echo "$init" >&2
  exit 1
fi

tools=$(mcp '{"jsonrpc":"2.0","id":2,"method":"tools/list"}')
for tool in read_guide list_records get_record make_offer offer_status withdraw_offer; do
  if ! grep -Fq "\"name\":\"$tool\"" <<<"$tools"; then
    echo "error: MCP door is missing tool $tool" >&2
    exit 1
  fi
done

# An empty offer is rejected by the real handler, so this never stores anything.
empty=$(mcp '{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"make_offer","arguments":{"offer":""}}}')
if ! grep -Fq 'invalid_offer' <<<"$empty"; then
  echo "error: MCP make_offer did not reach the offer handler's validation" >&2
  echo "$empty" >&2
  exit 1
fi

echo "Offer healthcheck passed: live form served, Function route active, OFFER_DB binding available, invalid input rejected without storage, and the MCP door answers with its six tools."
