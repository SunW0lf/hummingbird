#!/usr/bin/env bash
# Portable canonical backup entry point.
#
# Production use is read-only:
#   ./scripts/backup --remote --output /secure/off-repo/hummingbird-backup
#
# Local verification:
#   ./scripts/backup --local --persist-to /path/to/local-state --output /tmp/hummingbird-backup
set -euo pipefail

cd "$(dirname "$0")/.."
exec node scripts/export-canonical-backup.js "$@"
