#!/usr/bin/env bash
# Run all automated tests. Builds first since canonical document pages and
# other generated surfaces are checked from dist/, the deployable output.
set -euo pipefail

cd "$(dirname "$0")/.."

echo "Building before tests..."
./scripts/build

echo "Checking steward-tool syntax without remote access..."
node --check scripts/stage-public-d1.js
node --check scripts/promote-publication.js
node --check scripts/admit-draft-d1.js
node --check scripts/mark-published-d1.js

echo "Validating first Phase 2C draft-admission candidate without remote access..."
node scripts/admit-draft-d1.js admissions/candidates/seed15-visible-consequence.json --validate-only

echo "Running site smoke tests..."
node tests/site.test.js

echo "Running layout/site-identity regression checks..."
node tests/layout-identity.test.js

echo "Running Phase 2C public-record projection checks..."
node tests/public-records.test.js

echo "Running agent/public-read acceptance tests..."
node tests/agent-access.test.js

echo "Running documentation consistency checks..."
node tests/consistency.test.js

echo "Running canonical corpus contract checks..."
node tests/canonical.test.js

echo "Running local D1 migration/import/export round-trip checks..."
node tests/d1-roundtrip.test.js
