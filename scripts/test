#!/usr/bin/env bash
# Run all automated tests. Builds first since canonical document pages and
# other generated surfaces are checked from dist/, the deployable output.
set -euo pipefail

cd "$(dirname "$0")/.."

echo "Building before tests..."
./scripts/build

echo "Checking shell and steward-tool syntax without remote access..."
bash -n scripts/healthcheck
node --check scripts/stage-public-d1.js
node --check scripts/promote-publication.js
node --check scripts/admit-draft-d1.js
node --check scripts/mark-published-d1.js
node --check scripts/export-canonical-backup.js
node --check scripts/restore-canonical-backup.js
node --check scripts/phase2d-remote-recovery-drill.js
node --check scripts/provision-offer-pilot.mjs
node --check scripts/cleanup-offer-buffer.mjs
node --check scripts/observe-offer-buffer.mjs

echo "Compiling Pages Functions without deploying..."
rm -f .tmp-offer-worker.mjs
npx wrangler pages functions build functions --outfile=.tmp-offer-worker.mjs >/dev/null
rm -f .tmp-offer-worker.mjs

echo "Validating first Phase 2C draft-admission candidate without remote access..."
node scripts/admit-draft-d1.js admissions/candidates/seed15-visible-consequence.json --validate-only

echo "Running site smoke tests..."
node tests/site.test.js

echo "Running layout/site-identity regression checks..."
node tests/layout-identity.test.js

echo "Running decision provenance/representation checks..."
node tests/decision-provenance.test.js

echo "Running Phase 3 Offer Buffer design guards..."
node tests/offer-buffer-design.test.js

echo "Running Phase 2E offer pilot contract guards..."
node tests/offer-pilot-contract.test.js

echo "Running Phase 2E offer triage/review contract guards..."
node tests/offer-triage-contract.test.js

echo "Running Phase 2E offer runtime guards..."
node tests/offer-runtime.test.mjs
node tests/offer-launch-contract.test.js
python3 tests/offer-ingress-storage.py
node tests/offer-observer-contract.test.js
node tests/offer-review-export.test.js

echo "Running Phase 2C public-record projection checks..."
node tests/public-records.test.js

echo "Running agent/public-read acceptance tests..."
node tests/agent-access.test.js

echo "Running documentation consistency checks..."
node tests/consistency.test.js

echo "Running Phase 2D recovery documentation/changelog checks..."
node tests/recovery-docs.test.js

echo "Running Phase 2 evidence/gate review checks..."
node tests/phase2-review.test.js

echo "Running remote Phase 2D drill safety checks without remote access..."
node tests/remote-recovery-drill.test.js

echo "Running ordinary private-backup workflow safety checks..."
node tests/private-backup-workflow.test.js

echo "Running canonical corpus contract checks..."
node tests/canonical.test.js

echo "Running local D1 migration/import/export round-trip checks..."
node tests/d1-roundtrip.test.js

echo "Running Phase 2D portable-backup/recovery round-trip checks..."
node tests/recovery-contract.test.js
