#!/usr/bin/env bash
# Plain-HTTP production smoke test for Hummingbird's public read plane.
#
# Deliberately does not persist cookies, authenticate, execute JavaScript, or
# impersonate a verified crawler. A generic standards-compliant client should
# be able to read the public commons without proving participant origin.
set -euo pipefail

BASE_URL="${HEALTHCHECK_URL:-https://datum.quest}"
BASE_URL="${BASE_URL%/}"
USER_AGENT="${HEALTHCHECK_USER_AGENT:-Hummingbird-Public-Read-Smoke/1.0}"
ATTEMPTS="${HEALTHCHECK_ATTEMPTS:-6}"
RETRY_DELAY_SECONDS="${HEALTHCHECK_RETRY_DELAY_SECONDS:-2}"
TMP_DIR=$(mktemp -d)
trap 'rm -rf "${TMP_DIR}"' EXIT

challenge_check() {
  local headers="$1"
  local body="$2"

  if grep -Eiq '^cf-mitigated:[[:space:]]*challenge([[:space:]]|$)' "${headers}"; then
    echo "error: Cloudflare replaced the requested resource with a Challenge Page" >&2
    grep -Ei '^HTTP/|^content-type:|^server:|^cf-ray:|^cf-mitigated:|^location:' "${headers}" >&2 || true
    return 1
  fi

  if grep -Eiq '<title>[^<]*(just a moment|attention required)[^<]*</title>|verify you are human|enable javascript to continue|captcha' "${body}"; then
    echo "error: response appears to contain an interactive challenge or CAPTCHA" >&2
    grep -Ei '^HTTP/|^content-type:|^server:|^cf-ray:|^cf-mitigated:|^location:' "${headers}" >&2 || true
    grep -Eio -m1 '<title>[^<]*</title>|<h1[^>]*>[^<]*</h1>' "${body}" >&2 || true
    return 1
  fi
}

content_type_check() {
  local headers="$1"
  local expected="$2"
  local actual
  local actual_base

  actual=$(awk 'BEGIN { IGNORECASE=1 } /^content-type:/ { sub(/\r$/, ""); sub(/^[^:]+:[[:space:]]*/, ""); print; exit }' "${headers}")
  actual_base="${actual%%;*}"
  actual_base="${actual_base//[[:space:]]/}"

  if [ "${actual_base,,}" != "${expected,,}" ]; then
    echo "error: expected Content-Type ${expected}" >&2
    echo "received headers:" >&2
    grep -Ei '^content-type:|^server:|^cf-ray:' "${headers}" >&2 || true
    return 1
  fi
}

check_get() {
  local route="$1"
  local expected_type="$2"
  local marker="$3"
  local name
  name=$(printf '%s' "${route:-root}" | tr '/.' '__')
  local headers="${TMP_DIR}/${name}.headers"
  local body="${TMP_DIR}/${name}.body"
  local status="000"
  local attempt

  echo "GET ${route:-/}"
  for ((attempt=1; attempt<=ATTEMPTS; attempt++)); do
    : > "${headers}"
    : > "${body}"
    if ! status=$(curl -sS -D "${headers}" -o "${body}" -w '%{http_code}' \
      --max-time 20 --retry 2 --retry-all-errors \
      -A "${USER_AGENT}" -H 'Accept: */*' "${BASE_URL}${route}"); then
      status="000"
    fi

    if ! challenge_check "${headers}" "${body}"; then
      exit 1
    fi
    if [ "${status}" = "401" ] || [ "${status}" = "403" ]; then
      echo "error: GET ${route:-/} was denied with HTTP ${status}" >&2
      exit 1
    fi

    if [ "${status}" = "200" ] \
      && content_type_check "${headers}" "${expected_type}" >/dev/null 2>&1 \
      && grep -Fq "${marker}" "${body}"; then
      return 0
    fi

    if [ "${attempt}" -lt "${ATTEMPTS}" ]; then
      echo "  response not current yet (attempt ${attempt}/${ATTEMPTS}); retrying..."
      sleep "${RETRY_DELAY_SECONDS}"
    fi
  done

  if [ "${status}" != "200" ]; then
    echo "error: GET ${route:-/} expected HTTP 200, got ${status}" >&2
    exit 1
  fi
  content_type_check "${headers}" "${expected_type}"
  if ! grep -Fq "${marker}" "${body}"; then
    echo "error: GET ${route:-/} did not contain expected Hummingbird marker after ${ATTEMPTS} attempts: ${marker}" >&2
    exit 1
  fi
}

check_head_root() {
  local headers="${TMP_DIR}/head-root.headers"
  local status="000"
  local attempt

  echo "HEAD /"
  for ((attempt=1; attempt<=ATTEMPTS; attempt++)); do
    : > "${headers}"
    if ! status=$(curl -sS -I -D "${headers}" -o /dev/null -w '%{http_code}' \
      --max-time 20 --retry 2 --retry-all-errors \
      -A "${USER_AGENT}" -H 'Accept: text/html' "${BASE_URL}/"); then
      status="000"
    fi

    if grep -Eiq '^cf-mitigated:[[:space:]]*challenge([[:space:]]|$)' "${headers}"; then
      echo "error: HEAD / was replaced by a Cloudflare Challenge Page" >&2
      exit 1
    fi
    if [ "${status}" = "401" ] || [ "${status}" = "403" ]; then
      echo "error: HEAD / was denied with HTTP ${status}" >&2
      exit 1
    fi
    if [ "${status}" = "200" ] && content_type_check "${headers}" 'text/html' >/dev/null 2>&1; then
      return 0
    fi

    if [ "${attempt}" -lt "${ATTEMPTS}" ]; then
      echo "  HEAD response not current yet (attempt ${attempt}/${ATTEMPTS}); retrying..."
      sleep "${RETRY_DELAY_SECONDS}"
    fi
  done

  if [ "${status}" != "200" ]; then
    echo "error: HEAD / expected HTTP 200, got ${status}" >&2
    exit 1
  fi
  content_type_check "${headers}" 'text/html'
}

check_get '/' 'text/html' 'Hummingbird'
check_head_root
check_get '/llms.txt' 'text/plain' 'automated and interactive agents'
check_get '/robots.txt' 'text/plain' 'User-agent: *'
check_get '/sitemap.xml' 'application/xml' '<urlset'
check_get '/docs/raw/MISSION.md' 'text/markdown' '# Mission'
check_get '/records' 'text/html' 'Visible consequence without engagement pressure'
check_get '/records/contribution-visible-consequence' 'text/html' 'Visible consequence without engagement pressure'
check_get '/records/contribution-visible-consequence.json' 'application/json' '"id": "contribution-visible-consequence"'
check_get '/decisions' 'text/html' 'Verifiable source provenance'
check_get '/decisions/index.json' 'application/json' '"source_sha256"'
check_get '/decisions/proposal-schema.json' 'application/schema+json' '"affected_principles"'
check_get '/decisions/0015-standards-based-representation-discovery-and-provenance' 'text/html' 'Standards-Based Representation Discovery'
check_get '/docs/raw/decisions/0015-standards-based-representation-discovery-and-provenance.md' 'text/markdown' '# ADR 0015'

if ! grep -Eq 'href="(mission\.html|/mission(\.html)?)"' "${TMP_DIR}/_.body"; then
  echo "error: production root does not expose ordinary navigable About/Mission link" >&2
  exit 1
fi

if grep -Fq '/cdn-cgi/challenge-platform/' "${TMP_DIR}/_.body"; then
  echo "note: Cloudflare JavaScript Detections is present, but the complete public page was returned without requiring its execution"
fi

echo "Public-read healthcheck passed: plain HTTP GET/HEAD access is serving Hummingbird content without an interactive challenge or JavaScript requirement."
