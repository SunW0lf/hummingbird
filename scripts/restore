#!/usr/bin/env bash
# Portable canonical recovery entry point.
#
# Validate a bundle without mutation:
#   ./scripts/restore /path/to/backup --validate-only
#
# Restore only into an explicit isolated local D1 state directory:
#   ./scripts/restore /path/to/backup --local --persist-to /tmp/recovery-state --confirm-restore
#
# Remote restore is deliberately disabled until the Phase 2D recovery drill
# provisions a disposable replacement database and reviews the target boundary.
set -euo pipefail

cd "$(dirname "$0")/.."
exec node scripts/restore-canonical-backup.js "$@"
