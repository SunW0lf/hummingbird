# No secrets are required to build or test the Phase 1 static site.
#
# The variables below are only needed for deployment (./scripts/deploy, ./scripts/rollback)
# and are normally provided as GitHub Actions secrets, not a local .env file.
# Copy this file to .env only if you need to run a manual/emergency local deploy.

# Cloudflare API Token scoped to the datum.quest zone only (Pages:Edit, DNS:Edit).
CLOUDFLARE_API_TOKEN=

# Optional overrides (defaults shown):
# CLOUDFLARE_PAGES_PROJECT=hummingbird
# HEALTHCHECK_URL=https://datum.quest/
